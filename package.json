{
  "name": "tasko-desktop",
  "version": "0.1.1",
  "private": true,
  "description": "Tasko Mission Control — a local-first desktop workspace.",
  "author": "Tasko",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "test:security": "tsx --test tests/security-boundary.test.ts",
    "package:dir": "npm run build && electron-builder --dir",
    "make:mac": "npm run build && electron-builder --mac dmg --x64",
    "make:windows": "npm run build && electron-builder --win nsis --x64 --arm64",
    "model:download": "node scripts/download-local-model.mjs",
    "size:check": "tsx scripts/check-artifact-size.ts",
    "verify": "npm run typecheck && npm run build && npm test",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/noto-sans-arabic": "^5.2.8",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "node-llama-cpp": "^3.22.2",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/pdfkit": "^0.17.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.6.1",
    "electron-vite": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  },
  "build": {
    "appId": "com.vansh.tasko",
    "productName": "Tasko",
    "artifactName": "Tasko-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "npmRebuild": true,
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["out/**/*", "package.json", "!src/**/*", "!tests/**/*", "!docs/**/*", "!release/**/*"],
    "asarUnpack": ["node_modules/better-sqlite3/**", "node_modules/node-llama-cpp/**"],
    "extraResources": [{ "from": "assets", "to": "assets" }],
    "protocols": [{ "name": "Tasko link", "schemes": ["tasko"] }],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.icns",
      "target": [{ "target": "dmg", "arch": ["x64"] }, { "target": "zip", "arch": ["x64"] }],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extendInfo": { "LSMinimumSystemVersion": "12.0" }
    },
    "win": { "icon": "build/icon.png", "target": [{ "target": "nsis", "arch": ["x64", "arm64"] }] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tasko"
    },
    "publish": [{ "provider": "github", "owner": "vanshkbhardwaj-droid", "repo": "tasko-desktop", "releaseType": "release" }]
  }
}
